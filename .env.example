# Local development against the docker compose MinIO (`docker compose up -d minio`)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=stickers
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Comma-separated admin tokens; empty disables admin access
ADMIN_TOKENS=dev12345
